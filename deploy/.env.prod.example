# Copy to .env.prod on the server. Never commit the real .env.prod.

API_DOMAIN=api.example.com
WEB_DOMAIN=search.example.com
GRAFANA_DOMAIN=grafana.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional public upload guard. Set this before exposing POST /documents.
INGEST_API_KEY=replace-with-a-long-random-api-key
