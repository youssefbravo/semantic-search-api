# Copy to .env and adjust as needed. docker-compose injects its own values.

# Postgres (ParadeDB image bundles pgvector + pg_search)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantic_search

# Redis: db 0 = cache + rate-limit, db 1 = Celery broker, db 2 = Celery results
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Where uploaded raw bytes are staged for the worker (shared volume in compose)
UPLOAD_DIR=./data/uploads
